# hybrid-rag Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM Providers
# =============================================================================

# Groq (primary) - Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# OpenAI (for RAGAS evaluation) - Get key at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Ollama for local inference
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, for cloud
QDRANT_PREFER_GRPC=false

# =============================================================================
# Embedding Model
# =============================================================================

EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu  # or cuda

# Optional: Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=false

# =============================================================================
# Retrieval Settings
# =============================================================================

RETRIEVAL_TOP_K=10
RETRIEVAL_VECTOR_K=50
RETRIEVAL_BM25_K=50
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_TOP_K=20

# =============================================================================
# Chunking Settings
# =============================================================================

CHUNK_FIXED_TOKENS=512
CHUNK_FIXED_OVERLAP=50
CHUNK_HEADING_MAX_TOKENS=1024

# =============================================================================
# Fetching Settings
# =============================================================================

FETCH_RATE_LIMIT=2.0  # requests per second per source
FETCH_TIMEOUT=30.0
FETCH_MAX_RETRIES=3

# =============================================================================
# Evaluation
# =============================================================================

EVAL_QUESTIONS_FILE=data/eval/questions.yaml
EVAL_RESULTS_DIR=data/eval/results

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json  # or console